{
  "redirects": [
    {
      "source": "/media-kit",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/media-kit/",
      "destination": "/#contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media-kit/full",
      "destination": "/api/kit"
    },
    {
      "source": "/media-kit/full/",
      "destination": "/api/kit"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/home-md"
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ]
}
